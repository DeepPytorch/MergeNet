import os
import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
import torchvision.transforms as transforms
import torchvision.datasets as datasets
import matplotlib.pyplot as plt

# Track test accuracies for plotting
test_accuracies = []

torch.manual_seed(42)  # For reproducibility

# ==========================================
# 1. MODEL ARCHITECTURE DEFINITION (MergeNetV2)
# ==========================================

class SEBlock(nn.Module):
    """Squeeze-and-Excitation Block"""
    def __init__(self, channels, reduction=4):
        super().__init__()
        reduced_channels = max(1, channels // reduction)
        self.fc1 = nn.Conv2d(channels, reduced_channels, kernel_size=1)
        self.fc2 = nn.Conv2d(reduced_channels, channels, kernel_size=1)

    def forward(self, x):
        w = F.adaptive_avg_pool2d(x, 1)
        w = F.silu(self.fc1(w))
        w = torch.sigmoid(self.fc2(w))
        return x * w

class EfficientInceptionBlock(nn.Module):
    """Modernized Inception Block with Depthwise Convolutions"""
    def __init__(self, in_channels, out_channels, stride=1):
        super().__init__()
        self.stride = stride
        reduced = out_channels // 2 
        
        # Branch 1: 1x1
        self.branch1 = nn.Sequential(
            nn.Conv2d(in_channels, reduced, kernel_size=1, bias=False),
            nn.BatchNorm2d(reduced),
            nn.SiLU(inplace=True)
        )
        
        # Branch 2: 1x1 -> 3x3 Depthwise
        self.branch2 = nn.Sequential(
            nn.Conv2d(in_channels, reduced, kernel_size=1, bias=False),
            nn.BatchNorm2d(reduced),
            nn.SiLU(inplace=True),
            nn.Conv2d(reduced, reduced, kernel_size=3, stride=stride, padding=1, groups=reduced, bias=False),
            nn.BatchNorm2d(reduced),
            nn.SiLU(inplace=True)
        )
        
        # Branch 3: 1x1 -> Two 3x3 Depthwise
        self.branch3 = nn.Sequential(
            nn.Conv2d(in_channels, reduced, kernel_size=1, bias=False),
            nn.BatchNorm2d(reduced),
            nn.SiLU(inplace=True),
            nn.Conv2d(reduced, reduced, kernel_size=3, padding=1, groups=reduced, bias=False),
            nn.BatchNorm2d(reduced),
            nn.SiLU(inplace=True),
            nn.Conv2d(reduced, reduced, kernel_size=3, stride=stride, padding=1, groups=reduced, bias=False),
            nn.BatchNorm2d(reduced),
            nn.SiLU(inplace=True)
        )
        
        self.project = nn.Sequential(
            nn.Conv2d(reduced * 3, out_channels, kernel_size=1, bias=False),
            nn.BatchNorm2d(out_channels)
        )
        self.se = SEBlock(out_channels)
        
        if in_channels != out_channels or stride != 1:
            self.shortcut = nn.Sequential(
                nn.AvgPool2d(kernel_size=stride, stride=stride) if stride > 1 else nn.Identity(),
                nn.Conv2d(in_channels, out_channels, kernel_size=1, bias=False),
                nn.BatchNorm2d(out_channels)
            )
        else:
            self.shortcut = nn.Identity()

        self.final_activation = nn.SiLU(inplace=True)

    def forward(self, x):
        res = self.shortcut(x)
        b1 = self.branch1(x if self.stride == 1 else F.avg_pool2d(x, 2))
        b2 = self.branch2(x)
        b3 = self.branch3(x)
        
        out = torch.cat([b1, b2, b3], dim=1)
        out = self.project(out)
        out = self.se(out)
        
        return self.final_activation(out + res)

class Stem(nn.Module):
    def __init__(self, out_channels):
        super().__init__()
        self.body = nn.Sequential(
            nn.Conv2d(3, out_channels // 2, kernel_size=3, stride=2, padding=1, bias=False),
            nn.BatchNorm2d(out_channels // 2),
            nn.SiLU(inplace=True),
            nn.Conv2d(out_channels // 2, out_channels, kernel_size=3, stride=2, padding=1, groups=out_channels//2, bias=False),
            nn.BatchNorm2d(out_channels),
            nn.SiLU(inplace=True),
            nn.Conv2d(out_channels, out_channels, kernel_size=1, bias=False),
            nn.BatchNorm2d(out_channels),
            nn.SiLU(inplace=True)
        )

    def forward(self, x):
        return self.body(x)

class MergeNetV2(nn.Module):
    def __init__(self, num_classes=1000):
        super().__init__()
        self.stem = Stem(out_channels=64)
        
        self.stack1 = nn.Sequential(
            EfficientInceptionBlock(64, 128, stride=2),
            EfficientInceptionBlock(128, 128, stride=1),
            EfficientInceptionBlock(128, 128, stride=1)
        )
        
        self.stack2 = nn.Sequential(
            EfficientInceptionBlock(128, 256, stride=2),
            EfficientInceptionBlock(256, 256, stride=1),
            EfficientInceptionBlock(256, 256, stride=1),
            EfficientInceptionBlock(256, 256, stride=1)
        )
        
        self.stack3 = nn.Sequential(
            EfficientInceptionBlock(256, 512, stride=2),
            EfficientInceptionBlock(512, 512, stride=1),
            EfficientInceptionBlock(512, 512, stride=1),
            EfficientInceptionBlock(512, 512, stride=1)
        )
        
        self.stack4 = nn.Sequential(
            EfficientInceptionBlock(512, 1024, stride=2),
            EfficientInceptionBlock(1024, 1024, stride=1),
            EfficientInceptionBlock(1024, 1024, stride=1),
            EfficientInceptionBlock(1024, 1024, stride=1),
        )

        self.stack4 = nn.Sequential(
            EfficientInceptionBlock(1024, 2056, stride=2),
            EfficientInceptionBlock(2056, 2056, stride=1),
            EfficientInceptionBlock(2056, 2056, stride=1),
            EfficientInceptionBlock(2056, 2056, stride=1),
        )

        self.stack5 = nn.Sequential(
            EfficientInceptionBlock(2056, 3084, stride=2),
            EfficientInceptionBlock(3084, 3084, stride=1)
        )
        
        self.global_avg = nn.AdaptiveAvgPool2d((1, 1))
        self.dropout = nn.Dropout(0.2)
        self.classifier = nn.Linear(2056, num_classes)

    def forward(self, x):
        x = self.stem(x)
        x = self.stack1(x)
        x = self.stack2(x)
        x = self.stack3(x)
        x = self.stack4(x)
        
        x = self.global_avg(x)
        x = torch.flatten(x, 1)
        x = self.dropout(x)
        return self.classifier(x)

# ==========================================
# 2. UTILITY FUNCTIONS FOR TRAINING/TESTING
# ==========================================

def train(model, device, train_loader, optimizer, criterion, scheduler, epoch):
    model.train()
    total_loss = 0.0
    n = len(train_loader)
    print_every = max(1, n // 20)
    
    for batch_idx, (data, target) in enumerate(train_loader):
        data, target = data.to(device, non_blocking=True), target.to(device, non_blocking=True)
        
        optimizer.zero_grad(set_to_none=True)
        
        # Forward pass
        output = model(data)
        loss = criterion(output, target)
        
        # Backward pass
        loss.backward()
        optimizer.step()
        
        total_loss += loss.item()
        
        if (batch_idx + 1) % print_every == 0:
            avg = total_loss / (batch_idx + 1)
            pct = 100.0 * (batch_idx + 1) / n
            print(f' Epoch {epoch} [{pct:5.1f}%] batch {batch_idx+1}/{n} loss: {avg:.4f}')
            
    # Step the learning rate scheduler per epoch
    scheduler.step()

def test(model, device, test_loader, criterion):
    model.eval()
    test_loss = 0
    correct = 0
    
    with torch.no_grad():
        for data, target in test_loader:
            data, target = data.to(device, non_blocking=True), target.to(device, non_blocking=True)
            output = model(data)
            
            test_loss += criterion(output, target).item()
            pred = output.argmax(dim=1, keepdim=True)
            correct += pred.eq(target.view_as(pred)).sum().item()
            
    test_loss /= len(test_loader)
    acc = 100.0 * correct / len(test_loader.dataset)
    
    test_accuracies.append(acc) 
    print(f' → Validation loss: {test_loss:.4f} accuracy: {correct}/{len(test_loader.dataset)} ({acc:.4f}%)\n')
    return acc

# ==========================================
# 3. RUNTIME EXECUTION BLOCK
# ==========================================

if __name__ == '__main__':
    # Optimize CPU threading for data loading
    torch.set_num_threads(torch.get_num_threads())
    
    # Auto-detect hardware
    device = torch.device("cuda" if torch.cuda.is_available() else "mps" if torch.backends.mps.is_available() else "cpu")
    print(f"Using device: {device}\n")
    
    # Instantiate the network
    model = MergeNetV2(num_classes=1000).to(device)
    
    # Calculate and Print exact Parameter count
    total_params = sum(p.numel() for p in model.parameters())
    print("=" * 45)
    print(f'TOTAL MODEL PARAMETERS: {total_params:,}') 
    print("=" * 45 + "\n")

    # ImageNet standard normalization transforms
    train_transform = transforms.Compose([
        transforms.RandomResizedCrop(224),
        transforms.RandomHorizontalFlip(),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])

    test_transform = transforms.Compose([
        transforms.Resize(256),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])

    # ImageNet target local root path
    IMAGENET_PATH = './data/imagenet' 

    print("Attempting to verify and parse ImageNet directory maps...")
    if not os.path.exists(IMAGENET_PATH):
        print(f"\nCRITICAL ERROR: ImageNet path '{IMAGENET_PATH}' does not exist.")
        print("Please ensure your dataset is downloaded and structured correctly.")
        # Optional: exit(1) to prevent the PyTorch crash if the folder isn't there
    
    try:
        training_dataset = datasets.ImageNet(root=IMAGENET_PATH, split='train', transform=train_transform)
        testing_dataset = datasets.ImageNet(root=IMAGENET_PATH, split='val', transform=test_transform)

        # Data Loaders (using batch_size 128 as your GPU memory should now handle it beautifully)
        train_loader = torch.utils.data.DataLoader(
            training_dataset, batch_size=128, shuffle=True, num_workers=8, pin_memory=True, persistent_workers=True
        )
        test_loader = torch.utils.data.DataLoader(
            testing_dataset, batch_size=128, shuffle=False, num_workers=8, pin_memory=True, persistent_workers=True
        )

        criterion = nn.CrossEntropyLoss()
        epochs = 90 
        
        # AdamW is great, keeping your optimizers as requested
        optimizer = optim.AdamW(model.parameters(), lr=0.001, weight_decay=1e-4)
        scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)
        
        best_acc = 0.0
        
        # Main Training Loop
        for epoch in range(1, epochs + 1):
            print(f'Epoch {epoch}/{epochs}:')
            train(model, device, train_loader, optimizer, criterion, scheduler, epoch)
            current_acc = test(model, device, test_loader, criterion)
            
            # Save the best model weights
            if current_acc >= best_acc:
                best_acc = current_acc
                torch.save(model.state_dict(), 'MergeNetV2_ImageNet.pth')
                
        # Plotting the results
        plt.plot(range(1, epochs + 1), test_accuracies, marker='o', color='b')
        plt.xlabel('Epoch')
        plt.ylabel('Validation Accuracy (%)')
        plt.title('MergeNetV2 Validation Accuracy over Epochs (ImageNet-1K)')
        plt.grid(True)
        plt.tight_layout()
        plt.savefig('training_curve.png') # Good practice to save the plot when training remotely
        plt.show()

    except Exception as e:
        print(f"Failed to load dataset or start training: {e}")